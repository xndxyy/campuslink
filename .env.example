APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set true only when the deployment proxy overwrites X-Forwarded-For.
TRUST_PROXY=false

DATABASE_URL=postgresql://campuslink:campuslink_dev_password@localhost:5432/campuslink
POSTGRES_DB=campuslink
POSTGRES_USER=campuslink
POSTGRES_PASSWORD=campuslink_dev_password

MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=campuslink_minio
MINIO_ROOT_PASSWORD=campuslink_minio_dev_password
MINIO_BUCKET=campuslink

# With no SMTP settings, development logs the verification URL explicitly.
# Production requires all SMTP settings below; port 465 uses implicit TLS and
# all other ports require STARTTLS.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=campuslink-mailer
# SMTP_PASSWORD=replace-me
# MAIL_FROM=CampusLink <noreply@campuslink.local>
