APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set true only when the deployment proxy overwrites X-Forwarded-For.
TRUST_PROXY=false

DATABASE_URL=postgresql://campuslink:campuslink_dev_password@localhost:5432/campuslink
POSTGRES_DB=campuslink
POSTGRES_USER=campuslink
POSTGRES_PASSWORD=campuslink_dev_password

MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=campuslink_minio
MINIO_ROOT_PASSWORD=campuslink_minio_dev_password
MINIO_BUCKET=campuslink

# S3-compatible uploads (these defaults map to the local MinIO service above).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=campuslink_minio
S3_SECRET_ACCESS_KEY=campuslink_minio_dev_password
S3_BUCKET=campuslink
S3_FORCE_PATH_STYLE=true
# Local-only escape hatch for intentionally running integration tests without
# PostgreSQL/MinIO. CI rejects this flag even when set.
# ALLOW_SKIPPED_INTEGRATION=true

# Random scheduler-only bearer secret for POST /api/internal/uploads/cleanup.
# UPLOAD_CLEANUP_SECRET=replace-with-at-least-32-random-characters

# Cloudflare R2: use https://<account-id>.r2.cloudflarestorage.com, region
# "auto", R2 API credentials, and S3_FORCE_PATH_STYLE=false.

# With no SMTP settings, development logs the verification URL explicitly.
# Production requires all SMTP settings below; port 465 uses implicit TLS and
# all other ports require STARTTLS.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=campuslink-mailer
# SMTP_PASSWORD=replace-me
# MAIL_FROM=CampusLink <noreply@campuslink.local>
