generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  MODERATOR
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum IdentityProvider {
  GOOGLE
  MICROSOFT
  SAML
}

enum AssetKind {
  RESOURCE_IMAGE
  MARKETPLACE_IMAGE
}

enum AssetStatus {
  PENDING
  READY
  REJECTED
}

enum ContentStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
  ARCHIVED
}

enum FavouriteTargetType {
  RESOURCE
  MARKETPLACE_ITEM
  JOB_POST
}

enum ReportTargetType {
  USER
  ASSET
  RESOURCE
  MARKETPLACE_ITEM
  JOB_POST
}

enum ReportStatus {
  OPEN
  TRIAGED
  RESOLVED
  DISMISSED
}

enum ModerationSubjectType {
  USER
  ASSET
  RESOURCE
  MARKETPLACE_ITEM
  JOB_POST
}

enum ModerationActionType {
  APPROVE
  REJECT
  HIDE
  RESTORE
}

model Campus {
  id                 String            @id @default(cuid())
  slug               String            @unique @db.VarChar(64)
  name               String            @db.VarChar(200)
  allowedEmailDomain String            @unique @db.VarChar(255)
  isActive           Boolean           @default(true)
  users              User[]
  resources          Resource[]
  marketplaceItems   MarketplaceItem[]
  jobPosts           JobPost[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model User {
  id               String             @id @default(cuid())
  campusId         String
  name             String?            @db.VarChar(200)
  email            String             @unique @db.VarChar(320)
  passwordHash     String?            @db.VarChar(255)
  identityProvider IdentityProvider?
  role             UserRole           @default(STUDENT)
  status           UserStatus         @default(PENDING_VERIFICATION)
  emailVerifiedAt  DateTime?
  campus           Campus             @relation(fields: [campusId], references: [id], onDelete: Restrict)
  accounts         Account[]
  sessions         Session[]
  assets           Asset[]
  resources        Resource[]         @relation("ResourceAuthor")
  marketplaceItems MarketplaceItem[]  @relation("MarketplaceSeller")
  jobPosts         JobPost[]          @relation("JobAuthor")
  favourites       Favourite[]
  reports          Report[]           @relation("ReportReporter")
  assignedReports  Report[]           @relation("ReportAssignee")
  moderation       ModerationAction[] @relation("ModerationActor")
  auditLogs        AuditLog[]         @relation("AuditActor")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([campusId])
  @@index([campusId, role, status])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}

model Asset {
  id          String      @id @default(cuid())
  ownerId     String
  storageKey  String      @unique @default(cuid()) @db.VarChar(512)
  kind        AssetKind
  contentType String      @db.VarChar(255)
  sizeBytes   BigInt
  status      AssetStatus @default(PENDING)
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([ownerId, kind, status])
}

model Resource {
  id         String        @id @default(cuid())
  authorId   String
  campusId   String
  title      String        @db.VarChar(200)
  summary    String        @db.Text
  courseCode String?       @db.VarChar(64)
  tags       String[]      @default([])
  status     ContentStatus @default(DRAFT)
  author     User          @relation("ResourceAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  campus     Campus        @relation(fields: [campusId], references: [id], onDelete: Restrict)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([campusId, status, createdAt])
  @@index([authorId, status])
}

model MarketplaceItem {
  id          String        @id @default(cuid())
  sellerId    String
  campusId    String
  title       String        @db.VarChar(200)
  description String        @db.Text
  priceCents  Int
  condition   String        @db.VarChar(100)
  contact     String        @db.Text
  status      ContentStatus @default(DRAFT)
  seller      User          @relation("MarketplaceSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  campus      Campus        @relation(fields: [campusId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([campusId, status, createdAt])
  @@index([sellerId, status])
}

model JobPost {
  id          String        @id @default(cuid())
  authorId    String
  campusId    String
  company     String        @db.VarChar(200)
  title       String        @db.VarChar(200)
  description String        @db.Text
  location    String        @db.VarChar(200)
  payText     String        @db.VarChar(200)
  status      ContentStatus @default(DRAFT)
  author      User          @relation("JobAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  campus      Campus        @relation(fields: [campusId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([campusId, status, createdAt])
  @@index([authorId, status])
}

model Favourite {
  id         String              @id @default(cuid())
  userId     String
  targetType FavouriteTargetType
  targetId   String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model Report {
  id            String           @id @default(cuid())
  reporterId    String
  targetType    ReportTargetType
  targetId      String
  reason        String           @db.VarChar(500)
  details       String?          @db.Text
  status        ReportStatus     @default(OPEN)
  openReportKey String?          @unique @db.VarChar(512)
  assigneeId    String?
  reporter      User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  assignee      User?            @relation("ReportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([targetType, targetId, status])
  @@index([assigneeId, status])
}

model ModerationAction {
  id          String                @id @default(cuid())
  actorId     String
  subjectType ModerationSubjectType
  subjectId   String
  action      ModerationActionType
  reason      String                @db.Text
  actor       User                  @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([subjectType, subjectId, createdAt])
  @@index([actorId, createdAt])
}

model AuditLog {
  id          String                 @id @default(cuid())
  actorId     String?
  action      String                 @db.VarChar(100)
  subjectType ModerationSubjectType?
  subjectId   String?
  details     Json?
  actor       User?                  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime               @default(now())

  @@index([subjectType, subjectId, createdAt])
  @@index([actorId, createdAt])
}
