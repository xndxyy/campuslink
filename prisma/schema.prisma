generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  MODERATOR
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum AssetKind {
  RESOURCE_IMAGE
  RESOURCE_DOCUMENT
  MARKETPLACE_IMAGE
  ANNOUNCEMENT_IMAGE
}

enum AssetStatus {
  PENDING
  READY
  REJECTED
  CLEANING
}

enum AssetScanStatus {
  NOT_REQUIRED
  PENDING
  CLEAN
  INFECTED
  ERROR
}

enum ContentStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
  ARCHIVED
}

enum ForumPostKind {
  DISCUSSION
  TREE_HOLE
}

enum MarketplaceCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum TagScope {
  RESOURCE
  MARKETPLACE
  CAMPUS_WORK
}

enum FavouriteTargetType {
  RESOURCE
  MARKETPLACE_ITEM
  JOB_POST
}

enum ReportTargetType {
  USER
  ASSET
  RESOURCE
  MARKETPLACE_ITEM
  JOB_POST
  FORUM_POST
  FORUM_COMMENT
}

enum ReportStatus {
  OPEN
  TRIAGED
  RESOLVED
  DISMISSED
}

enum ReportReason {
  SPAM
  MISLEADING
  HARASSMENT
  PROHIBITED
  OTHER
}

enum ModerationSubjectType {
  CAMPUS
  USER
  ASSET
  ANNOUNCEMENT
  RESOURCE
  MARKETPLACE_ITEM
  JOB_POST
  FORUM_POST
  FORUM_COMMENT
  REPORT
  TAG_DEFINITION
}

enum ModerationActionType {
  APPROVE
  REJECT
  HIDE
  RESTORE
  ARCHIVE
  TRIAGE
  DISMISS
  RESOLVE
}

enum ContentAssessmentTarget {
  RESOURCE
  MARKETPLACE_ITEM
  CAMPUS_WORK
  FORUM_POST
  FORUM_COMMENT
  CUSTOM_TAG
}

enum ContentAssessmentDecision {
  PASS
  REVIEW
  BLOCK
}

enum ProviderExecutionStatus {
  COMPLETED
  SKIPPED
}

model Campus {
  id                 String              @id @default(cuid())
  slug               String              @unique @db.VarChar(64)
  name               String              @db.VarChar(200)
  allowedEmailDomain String?             @unique @db.VarChar(255)
  isActive           Boolean             @default(true)
  users              User[]
  resources          Resource[]
  marketplaceItems   MarketplaceItem[]
  jobPosts           JobPost[]
  campusWorkPosts    CampusWorkPost[]
  forumCategories    ForumCategory[]
  tagDefinitions     TagDefinition[]
  announcements      Announcement[]      @relation("AnnouncementCampus")
  reports            Report[]
  auditLogs          AuditLog[]
  blockedWords       BlockedWord[]
  aiModerationConfig AiModerationConfig?
  contentAssessments ContentAssessment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model BlockedWord {
  id         String   @id @default(cuid())
  campusId   String
  original   String   @db.VarChar(200)
  normalized String   @db.VarChar(200)
  category   String   @db.VarChar(100)
  reason     String   @db.VarChar(1000)
  enabled    Boolean  @default(true)
  campus     Campus   @relation(fields: [campusId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campusId, normalized])
  @@index([campusId, enabled, category])
}

model AiModerationConfig {
  id                String              @id @default(cuid())
  campusId          String              @unique
  enabled           Boolean             @default(false)
  baseUrl           String              @db.VarChar(500)
  model             String              @db.VarChar(200)
  encryptedApiKey   String              @db.Text
  apiKeyLastFour    String              @db.VarChar(4)
  encryptionVersion Int
  timeoutMs         Int                 @default(8000)
  reviewThreshold   Int                 @default(40)
  blockThreshold    Int                 @default(80)
  campus            Campus              @relation(fields: [campusId], references: [id], onDelete: Restrict)
  assessments       ContentAssessment[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([id, campusId])
}

model ContentAssessment {
  id             String                    @id @default(cuid())
  campusId       String
  configId       String?
  targetType     ContentAssessmentTarget
  targetId       String                    @db.VarChar(200)
  decision       ContentAssessmentDecision
  providerStatus ProviderExecutionStatus
  riskScore      Int?
  categories     String[]                  @default([])
  reasonZh       String?                   @db.Text
  suggestionZh   String?                   @db.Text
  adminSignals   Json?
  model          String?                   @db.VarChar(200)
  campus         Campus                    @relation(fields: [campusId], references: [id], onDelete: Restrict)
  config         AiModerationConfig?       @relation(fields: [configId, campusId], references: [id, campusId], onDelete: Restrict)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([campusId, decision, createdAt, id])
  @@index([campusId, providerStatus, createdAt, id])
  @@index([targetType, targetId, createdAt, id])
  @@index([configId])
}

model User {
  id               String             @id @default(cuid())
  campusId         String
  name             String?            @db.VarChar(200)
  email            String             @unique @db.VarChar(320)
  passwordHash     String?            @db.VarChar(255)
  role             UserRole           @default(STUDENT)
  status           UserStatus         @default(PENDING_VERIFICATION)
  emailVerifiedAt  DateTime?
  campus           Campus             @relation(fields: [campusId], references: [id], onDelete: Restrict)
  sessions         Session[]
  assets           Asset[]
  resources        Resource[]         @relation("ResourceAuthor")
  marketplaceItems MarketplaceItem[]  @relation("MarketplaceSeller")
  jobPosts         JobPost[]          @relation("JobAuthor")
  campusWorkPosts  CampusWorkPost[]   @relation("CampusWorkAuthor")
  forumPosts       ForumPost[]        @relation("ForumPostAuthor")
  forumComments    ForumComment[]     @relation("ForumCommentAuthor")
  forumLikes       ForumLike[]
  announcements    Announcement[]     @relation("AnnouncementAuthor")
  favourites       Favourite[]
  reports          Report[]           @relation("ReportReporter")
  assignedReports  Report[]           @relation("ReportAssignee")
  moderation       ModerationAction[] @relation("ModerationActor")
  auditLogs        AuditLog[]         @relation("AuditActor")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([campusId])
  @@index([campusId, role, status])
  @@index([campusId, createdAt(sort: Desc), id(sort: Desc)], map: "User_campus_createdAt_id_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_email_trgm_idx")
}

model Session {
  id               String   @id @default(cuid())
  sessionTokenHash String   @unique @db.VarChar(128)
  userId           String
  expires          DateTime
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  tokenHash  String   @unique @db.VarChar(128)
  expires    DateTime
  createdAt  DateTime @default(now())
}

model RateLimitBucket {
  keyHash         String   @id @db.VarChar(64)
  windowStartedAt DateTime
  count           Int
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model Asset {
  id                String           @id @default(cuid())
  ownerId           String
  resourceId        String?
  marketplaceItemId String?
  announcementId    String?          @unique
  storageKey        String           @unique @default(cuid()) @db.VarChar(512)
  kind              AssetKind
  contentType       String           @db.VarChar(255)
  sizeBytes         BigInt
  status            AssetStatus      @default(PENDING)
  scanStatus        AssetScanStatus  @default(NOT_REQUIRED)
  scanSha256        String?          @db.VarChar(64)
  scannedAt         DateTime?
  uploadExpiresAt   DateTime?
  owner             User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  resource          Resource?        @relation("ResourceAssets", fields: [resourceId], references: [id], onDelete: SetNull)
  marketplaceItem   MarketplaceItem? @relation("MarketplaceItemAssets", fields: [marketplaceItemId], references: [id], onDelete: SetNull)
  announcement      Announcement?    @relation("AnnouncementCover", fields: [announcementId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([ownerId, kind, status])
  @@index([status, uploadExpiresAt])
  @@index([kind, scanStatus, status])
  @@index([resourceId])
  @@index([marketplaceItemId])
}

model Announcement {
  id          String   @id @default(cuid())
  campusId    String
  authorId    String
  title       String   @db.VarChar(200)
  body        String   @db.Text
  isPinned    Boolean  @default(false)
  publishedAt DateTime @default(now())
  campus      Campus   @relation("AnnouncementCampus", fields: [campusId], references: [id], onDelete: Restrict)
  author      User     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  cover       Asset?   @relation("AnnouncementCover")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([campusId, isPinned, publishedAt, id])
}

model StorageDeletionJob {
  id          String   @id @default(cuid())
  storageKey  String   @unique @db.VarChar(512)
  attempts    Int      @default(0)
  nextAttempt DateTime @default(now())
  lastError   String?  @db.VarChar(200)
  createdAt   DateTime @default(now())

  @@index([nextAttempt, id])
}

model TagDefinition {
  id              String           @id @default(cuid())
  campusId        String
  scope           TagScope
  label           String           @db.VarChar(32)
  slug            String           @db.VarChar(40)
  isPreset        Boolean          @default(false)
  isActive        Boolean          @default(true)
  campus          Campus           @relation(fields: [campusId], references: [id], onDelete: Restrict)
  resourceTags    ResourceTag[]
  marketplaceTags MarketplaceTag[]
  campusWorkTags  CampusWorkTag[]
  createdAt       DateTime         @default(now())

  @@unique([campusId, scope, slug])
  @@unique([id, campusId, scope])
  @@index([campusId, scope, isActive, label])
  @@index([campusId, scope, label, id], map: "TagDefinition_campusId_scope_label_id_idx")
}

model Resource {
  id             String        @id @default(cuid())
  authorId       String
  campusId       String
  title          String        @db.VarChar(200)
  summary        String        @db.Text
  courseCode     String?       @db.VarChar(64)
  tags           String[]      @default([])
  status         ContentStatus @default(DRAFT)
  author         User          @relation("ResourceAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  campus         Campus        @relation(fields: [campusId], references: [id], onDelete: Restrict)
  assets         Asset[]       @relation("ResourceAssets")
  tagAssignments ResourceTag[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([campusId, status, createdAt])
  @@index([authorId, status])
}

model MarketplaceItem {
  id             String               @id @default(cuid())
  sellerId       String
  campusId       String
  title          String               @db.VarChar(200)
  description    String               @db.Text
  priceCents     Int
  condition      MarketplaceCondition
  pickupArea     String               @db.VarChar(200)
  contact        String               @db.Text
  status         ContentStatus        @default(DRAFT)
  seller         User                 @relation("MarketplaceSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  campus         Campus               @relation(fields: [campusId], references: [id], onDelete: Restrict)
  assets         Asset[]              @relation("MarketplaceItemAssets")
  tagAssignments MarketplaceTag[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([campusId, status, createdAt])
  @@index([sellerId, status])
}

model JobPost {
  id          String        @id @default(cuid())
  authorId    String
  campusId    String
  company     String        @db.VarChar(200)
  title       String        @db.VarChar(200)
  description String        @db.Text
  location    String        @db.VarChar(200)
  payText     String        @db.VarChar(200)
  status      ContentStatus @default(DRAFT)
  author      User          @relation("JobAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  campus      Campus        @relation(fields: [campusId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([campusId, status, createdAt])
  @@index([authorId, status])
}

model CampusWorkPost {
  id             String          @id @default(cuid())
  authorId       String
  campusId       String
  company        String?         @db.VarChar(200)
  title          String          @db.VarChar(200)
  description    String          @db.Text
  location       String          @db.VarChar(200)
  payText        String          @db.VarChar(200)
  contact        String?         @db.Text
  status         ContentStatus   @default(DRAFT)
  author         User            @relation("CampusWorkAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  campus         Campus          @relation(fields: [campusId], references: [id], onDelete: Restrict)
  tagAssignments CampusWorkTag[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([campusId, status, createdAt, id])
  @@index([authorId, status])
}

model ForumCategory {
  id        String      @id @default(cuid())
  campusId  String
  slug      String      @db.VarChar(64)
  label     String      @db.VarChar(100)
  isActive  Boolean     @default(true)
  campus    Campus      @relation(fields: [campusId], references: [id], onDelete: Restrict)
  posts     ForumPost[] @relation("ForumPostCategory")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([campusId, slug])
  @@index([campusId, isActive, label, id])
}

model ForumPost {
  id                   String         @id @default(cuid())
  campusId             String
  kind                 ForumPostKind
  authorId             String?
  /// Complete authenticated encryption envelope; IV and tag are serialized inside.
  anonymousCiphertext  String?        @db.Text
  anonymousFingerprint String?        @db.VarChar(64)
  anonymousKeyVersion  Int?
  publicCode           String?        @unique @db.VarChar(12)
  title                String         @db.VarChar(200)
  body                 String         @db.Text
  category             String         @db.VarChar(64)
  status               ContentStatus  @default(DRAFT)
  author               User?          @relation("ForumPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  categoryDefinition   ForumCategory  @relation("ForumPostCategory", fields: [campusId, category], references: [campusId, slug], onDelete: Restrict)
  comments             ForumComment[]
  likes                ForumLike[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([campusId, kind, status, createdAt, id])
  @@index([campusId, kind, status, category, createdAt, id], map: "ForumPost_campusId_kind_status_category_createdAt_id_idx")
  @@index([campusId, anonymousFingerprint, createdAt, id], map: "ForumPost_campusId_anonymousFingerprint_createdAt_id_idx")
  @@index([authorId, status, createdAt, id])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "ForumPost_title_trgm_idx")
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin, map: "ForumPost_body_trgm_idx")
}

model ForumComment {
  id        String        @id @default(cuid())
  postId    String
  authorId  String
  body      String        @db.Text
  status    ContentStatus @default(PUBLISHED)
  post      ForumPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User          @relation("ForumCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId, status, createdAt, id])
  @@index([authorId, createdAt, id])
}

model ForumLike {
  id        String    @id @default(cuid())
  userId    String
  postId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, postId])
  @@index([postId, createdAt, id])
}

model ResourceTag {
  resourceId String
  tagId      String
  campusId   String
  scope      TagScope      @default(RESOURCE)
  resource   Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag        TagDefinition @relation(fields: [tagId, campusId, scope], references: [id, campusId, scope], onDelete: Restrict)

  @@id([resourceId, tagId])
  @@index([tagId, resourceId])
}

model MarketplaceTag {
  marketplaceItemId String
  tagId             String
  campusId          String
  scope             TagScope        @default(MARKETPLACE)
  marketplaceItem   MarketplaceItem @relation(fields: [marketplaceItemId], references: [id], onDelete: Cascade)
  tag               TagDefinition   @relation(fields: [tagId, campusId, scope], references: [id, campusId, scope], onDelete: Restrict)

  @@id([marketplaceItemId, tagId])
  @@index([tagId, marketplaceItemId])
}

model CampusWorkTag {
  campusWorkPostId String
  tagId            String
  campusId         String
  scope            TagScope       @default(CAMPUS_WORK)
  campusWorkPost   CampusWorkPost @relation(fields: [campusWorkPostId], references: [id], onDelete: Cascade)
  tag              TagDefinition  @relation(fields: [tagId, campusId, scope], references: [id, campusId, scope], onDelete: Restrict)

  @@id([campusWorkPostId, tagId])
  @@index([tagId, campusWorkPostId])
}

model Favourite {
  id         String              @id @default(cuid())
  userId     String
  targetType FavouriteTargetType
  targetId   String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([userId, targetType, targetId])
  @@index([userId, createdAt, id])
  @@index([targetType, targetId])
}

model Report {
  id         String           @id @default(cuid())
  campusId   String
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     ReportReason
  details    String?          @db.Text
  status     ReportStatus     @default(OPEN)
  assigneeId String?
  campus     Campus           @relation(fields: [campusId], references: [id], onDelete: Restrict)
  reporter   User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  assignee   User?            @relation("ReportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([targetType, targetId, status])
  @@index([assigneeId, status])
  @@index([campusId, status, createdAt, id])
}

model ModerationAction {
  id          String                @id @default(cuid())
  actorId     String
  subjectType ModerationSubjectType
  subjectId   String
  action      ModerationActionType
  reason      String                @db.Text
  actor       User                  @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([subjectType, subjectId, createdAt])
  @@index([actorId, createdAt])
}

model AuditLog {
  id          String                 @id @default(cuid())
  campusId    String
  actorId     String?
  action      String                 @db.VarChar(100)
  subjectType ModerationSubjectType?
  subjectId   String?
  details     Json?
  campus      Campus                 @relation(fields: [campusId], references: [id], onDelete: Restrict)
  actor       User?                  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime               @default(now())

  @@index([subjectType, subjectId, createdAt])
  @@index([actorId, createdAt])
  @@index([campusId, createdAt, id])
}

model AuditLogQuarantine {
  originalId        String                 @id
  actorId           String?
  event             String                 @db.VarChar(100)
  entityType        ModerationSubjectType?
  entityId          String?
  metadata          Json?
  originalCreatedAt DateTime
  reason            String                 @db.Text
  quarantinedAt     DateTime               @default(now())
}
